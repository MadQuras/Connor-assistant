{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Connor",
  "version": "1.3.0",
  "identifier": "com.connor.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "КОННОР · RK800",
        "width": 1140,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/window-icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/app-icon.ico"
    ]
  }
}
